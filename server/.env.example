# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local Fedora Instance:
# MONGODB_URI=mongodb://127.0.0.1:27017/grabmykey
# MONGO_URI=mongodb://127.0.0.1:27017/grabmykey
# Or MongoDB Atlas Cloud Cluster:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/grabmykey?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/grabmykey?retryWrites=true&w=majority

# Production Frontend Client URLs (comma-separated for CORS whitelist)
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://grabmykey.in,https://www.grabmykey.in

# Cloudinary Persistent Cloud Image Storage (https://cloudinary.com/console)
